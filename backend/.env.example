# Copy this file to .env (next to VST.exe on VDI, or in backend/ for dev) and fill in values.
# Lines starting with # are ignored. Existing environment variables are not overwritten.

# Elastic password (required to download logs).
ELASTIC_PASS=

# Elastic user (optional, defaults to "solar").
ELASTIC_USER=solar

# Elastic connection overrides (optional).
# ELASTIC_URL=https://logs.proc.lan/s/solar-prod/api/console/proxy?path=_sql?format=csv&method=POST
# ELASTIC_INDEX=prod-*
# ELASTIC_APP_NAME=solar-acs
# ELASTIC_HOSTS=acss201,acss202
# ELASTIC_TIME_ZONE=Europe/Athens
# ELASTIC_TZ_OFFSET=+03:00

# TLS verification for Elastic (optional). Default is OFF, because the internal
# endpoint uses a self-signed certificate. Set to 1 to require verification, or set
# ELASTIC_CA_BUNDLE to a corporate CA file (which also turns verification on).
# ELASTIC_VERIFY_TLS=0
# ELASTIC_CA_BUNDLE=

# Data integrity thresholds (optional).
# ELASTIC_MAX_DROPPED=100
# PARSER_MAX_DROPPED=100

# Storage path overrides (optional). Default is data/ next to the exe.
# LOG_STORAGE_DIR=
# CSV_STORAGE_DIR=
# REPORT_OUTPUT_DIR=

# SMTP settings for the future daily report worker (optional).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=
# SMTP_PASS=
# REPORT_EMAIL_FROM=
# REPORT_EMAIL_TO=
# REPORT_EMAIL_SUBJECT=VST daily report
